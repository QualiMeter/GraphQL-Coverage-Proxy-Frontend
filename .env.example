# Server-only Vite proxy settings. Never put backend keys/passwords here or in VITE_*.
COVERAGE_API_PROXY_TARGET=https://graphql.rebyte.fun

# Explicit opt-in, only for npm run dev at http://localhost:5173.
# Uses real production sessions/data. Prefer a separate browser profile/test operator.
# Restart Vite after changing this flag. See README for cookie/browser limitations.
COVERAGE_DEV_PROXY_PRODUCTION_AUTH=false

# Optional ordinary development target (keep production auth disabled):
# COVERAGE_API_PROXY_TARGET=http://localhost:8000
